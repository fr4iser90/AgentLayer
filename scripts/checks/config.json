      "module": "command_check",
      "provider_env": "CVE_PROVIDER",
      "default_provider": "local",
      "providers": {
        "local": {
          "required_python_module": "pip_audit",
          "nix_shell_command": "pip-audit -r requirements.txt -r plugins/interfaces/discord/requirements.txt",
          "command": [
            "python3",
            "-m",
            "pip_audit",
            "-r",
            "requirements.txt",
            "-r",
            "plugins/interfaces/discord/requirements.txt"
          ]
        },
        "osv": {
          "required_tool": "osv-scanner",
          "command": ["osv-scanner", "requirements.txt", "plugins/interfaces/discord/requirements.txt"]
        },
        "snyk": {
          "required_tool": "snyk",
          "command": ["snyk", "test", "--file=requirements.txt"]
        }
      }
    },
    "bandit": {
      "module": "command_check",
      "provider_env": "QUALITY_PROVIDER",
      "default_provider": "local",
      "required": false,
      "providers": {
        "local": {
          "required_python_module": "bandit",
          "command": ["python3", "-m", "bandit", "-r", "apps/backend", "-c", "pyproject.toml"]
        },
        "semgrep": {
          "required_tool": "semgrep",
          "command": ["semgrep", "--config", "auto", "apps/backend"]
        },
        "sonar": {

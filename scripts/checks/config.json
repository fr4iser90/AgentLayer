{
  "profiles": {
    "fast": ["ddd_layers", "ddd_quality", "agent_governance", "frontend_i18n"],
    "precommit": ["ddd_layers", "ddd_quality", "agent_governance", "backend_unit", "frontend_i18n", "node_cve_full", "python_cve"],
    "security": ["node_cve_full", "python_cve"],
    "architecture": ["ddd_layers_report", "ddd_quality", "agent_governance"],
    "quality": ["agent_governance", "backend_unit", "frontend_i18n", "bandit"],
    "ci": ["ddd_layers_all", "ddd_quality", "agent_governance", "backend_unit", "frontend_i18n", "node_cve_full", "python_cve", "bandit"]
  },
  "checks": {
    "ddd_layers": {
      "module": "ddd_layers",
      "scope": "staged",
      "include": ["apps/backend"],
      "ignore": [
        "apps/backend/infrastructure/db/migrations/**"
      ],
      "rules": [
        {
          "name": "domain",
          "path": "apps/backend/domain",
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.application",
            "apps.backend.dashboard",
            "apps.backend.infrastructure",
            "apps.backend.infrastructure.integrations",
            "apps.backend.infrastructure.media"
          ]
        },
        {
          "name": "application",
          "path": "apps/backend/application",
          "enforce": false,
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.dashboard",
            "apps.backend.infrastructure.integrations"
          ]
        },
        {
          "name": "api",
          "path": "apps/backend/api",
          "forbidden_imports": [
            "apps.backend.dashboard",
            "apps.backend.infrastructure",
            "apps.backend.infrastructure.integrations"
          ]
        },
        {
          "name": "api_provider_controllers",
          "path": "apps/backend/api/providers/controllers",
          "forbidden_imports": [
            "apps.backend.infrastructure"
          ]
        },
        {
          "name": "infrastructure",
          "path": "apps/backend/infrastructure",
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.dashboard"
          ]
        }
      ]
    },
    "ddd_layers_all": {
      "module": "ddd_layers",
      "scope": "all",
      "include": ["apps/backend"],
      "ignore": [
        "apps/backend/infrastructure/db/migrations/**"
      ],
      "rules": [
        {
          "name": "domain",
          "path": "apps/backend/domain",
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.application",
            "apps.backend.dashboard",
            "apps.backend.infrastructure",
            "apps.backend.infrastructure.integrations",
            "apps.backend.infrastructure.media"
          ]
        },
        {
          "name": "application",
          "path": "apps/backend/application",
          "enforce": false,
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.dashboard",
            "apps.backend.infrastructure.integrations"
          ]
        },
        {
          "name": "api",
          "path": "apps/backend/api",
          "forbidden_imports": [
            "apps.backend.dashboard",
            "apps.backend.infrastructure",
            "apps.backend.infrastructure.integrations"
          ]
        },
        {
          "name": "api_provider_controllers",
          "path": "apps/backend/api/providers/controllers",
          "forbidden_imports": [
            "apps.backend.infrastructure"
          ]
        },
        {
          "name": "infrastructure",
          "path": "apps/backend/infrastructure",
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.dashboard"
          ]
        }
      ]
    },
    "ddd_layers_report": {
      "module": "ddd_layers",
      "scope": "all",
      "report_only": true,
      "summary_limit": 25,
      "include": ["apps/backend"],
      "ignore": [
        "apps/backend/infrastructure/db/migrations/**"
      ],
      "rules": [
        {
          "name": "domain",
          "path": "apps/backend/domain",
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.application",
            "apps.backend.dashboard",
            "apps.backend.infrastructure",
            "apps.backend.infrastructure.integrations",
            "apps.backend.infrastructure.media"
          ]
        },
        {
          "name": "application",
          "path": "apps/backend/application",
          "enforce": false,
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.dashboard",
            "apps.backend.infrastructure.integrations"
          ]
        },
        {
          "name": "api",
          "path": "apps/backend/api",
          "forbidden_imports": [
            "apps.backend.dashboard",
            "apps.backend.infrastructure",
            "apps.backend.infrastructure.integrations"
          ]
        },
        {
          "name": "api_provider_controllers",
          "path": "apps/backend/api/providers/controllers",
          "forbidden_imports": [
            "apps.backend.infrastructure"
          ]
        },
        {
          "name": "infrastructure",
          "path": "apps/backend/infrastructure",
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.dashboard"
          ]
        }
      ]
    },
    "ddd_quality": {
      "module": "ddd_quality",
      "layer_roots": [
        {
          "name": "backend",
          "path": "apps/backend",
          "allow_dirs": ["api", "application", "domain", "infrastructure"],
          "allow_files": ["__init__.py"],
          "ignore_dirs": ["__pycache__"]
        }
      ],
      "root_module_limits": [
        {
          "name": "infrastructure",
          "path": "apps/backend/infrastructure",
          "allow_files": ["__init__.py"],
          "max_files": 0
        }
      ],
      "forbidden_dirs": [],
      "bounded_context_roots": [
        {
          "name": "api",
          "path": "apps/backend/api",
          "allow_files": ["__init__.py", "main.py"]
        },
        {
          "name": "domain",
          "path": "apps/backend/domain",
          "allow_files": ["__init__.py"]
        }
      ],
      "package_roots": [
        {
          "name": "api",
          "path": "apps/backend/api",
          "allow_files": ["__init__.py"],
          "required_dirs": ["controllers"],
          "ignore_dirs": ["__pycache__"]
        }
      ],
      "required_context_files": [
        {
          "name": "application",
          "path": "apps/backend/application",
          "contexts": [
            "agent_runtime",
            "benchmarks",
            "collections",
            "dashboards",
            "identity",
            "model_routing",
            "platform",
            "providers",
            "rag",
            "setup",
            "sharing",
            "studio",
            "tools",
            "voice",
            "workspace"
          ],
          "required": [
            "__init__.py",
            "ports.py",
            "commands/__init__.py",
            "queries/__init__.py",
            "dtos/__init__.py",
            "use_cases/__init__.py"
          ]
        },
        {
          "name": "domain",
          "path": "apps/backend/domain",
          "contexts": [
            "agent_runtime",
            "collections",
            "dashboards",
            "delegation",
            "identity",
            "model_routing",
            "plugin_system",
            "providers",
            "rag",
            "scheduling",
            "setup",
            "shares",
            "studio",
            "tools",
            "voice",
            "workspace"
          ],
          "required": [
            "__init__.py",
            "entities.py",
            "repositories.py",
            "schemas.py",
            "value_objects.py"
          ]
        }
      ],
      "tactical_module_roots": [
        "apps/backend/domain"
      ],
      "forbidden_terms": [
        {
          "name": "backend",
          "path": "apps/backend",
          "terms": ["facade"],
          "ignore_dirs": ["__pycache__", "db/migrations"]
        }
      ],
      "forbidden_module_globs": [
        {
          "name": "infrastructure",
          "path": "apps/backend/infrastructure",
          "patterns": ["*_api.py", "*_websocket.py"],
          "ignore_dirs": ["__pycache__"]
        }
      ],
      "large_file_roots": [
        "apps/backend/api",
        "apps/backend/infrastructure",
        "apps/backend/domain",
        "apps/backend/application"
      ],
      "large_file_enforce": true,
      "large_file_warn_lines": 600,
      "large_file_summary_limit": 12
    },
    "agent_governance": {
      "module": "agent_governance",
      "agents_root": "plugins/agents",
      "required_fields": ["id", "name", "description", "min_role", "requires_workspace", "execution_context"],
      "prompt_warn_max_chars": 8000,
      "prompt_hard_max_chars": 12000,
      "max_pinned_tools": 12,
      "max_tool_allowlist": 80,
      "max_prompt_emoji": 0,
      "forbidden_prompt_phrases": [
        "Your tools (only these)"
      ]
    },
    "backend_unit": {
      "module": "command_check",
      "command": [
        "python3",
        "-m",
        "pytest",
        "tests/unit",
        "tests/benchmarks",
        "-m",
        "not e2e and not benchmark",
        "-q",
        "--tb=short"
      ],
      "env": {
        "PYTHONPATH": "."
      }
    },
    "frontend_i18n": {
      "module": "command_check",
      "kind": "frontend_i18n",
      "cwd": "apps/frontend"
    },
    "node_cve": {
      "module": "command_check",
      "provider_env": "CVE_PROVIDER",
      "default_provider": "local",
      "providers": {
        "local": {
          "cwd": "apps/frontend",
          "required_tool": "npm",
          "nix_shell_command": "cd apps/frontend && npm audit --omit=dev --audit-level=high",
          "command": ["npm", "audit", "--omit=dev", "--audit-level=high"]
        },
        "osv": {
          "required_tool": "osv-scanner",
          "command": ["osv-scanner", "--lockfile=apps/frontend/package-lock.json"]
        },
        "snyk": {
          "required_tool": "snyk",
          "command": ["snyk", "test", "apps/frontend"]
        }
      }
    },
    "node_cve_full": {
      "module": "command_check",
      "provider_env": "CVE_PROVIDER",
      "default_provider": "local",
      "providers": {
        "local": {
          "cwd": "apps/frontend",
          "required_tool": "npm",
          "nix_shell_command": "cd apps/frontend && npm audit --audit-level=high",
          "command": ["npm", "audit", "--audit-level=high"]
        },
        "osv": {
          "required_tool": "osv-scanner",
          "command": ["osv-scanner", "--lockfile=apps/frontend/package-lock.json"]
        },
        "snyk": {
          "required_tool": "snyk",
          "command": ["snyk", "test", "apps/frontend"]
        }
      }
    },
    "python_cve": {
      "module": "command_check",
      "provider_env": "CVE_PROVIDER",
      "default_provider": "local",
      "providers": {
        "local": {
          "required_python_module": "pip_audit",
          "nix_shell_command": "pip-audit -r requirements.txt -r plugins/interfaces/discord/requirements.txt",
          "command": [
            "python3",
            "-m",
            "pip_audit",
            "-r",
            "requirements.txt",
            "-r",
            "plugins/interfaces/discord/requirements.txt"
          ]
        },
        "osv": {
          "required_tool": "osv-scanner",
          "command": ["osv-scanner", "requirements.txt", "plugins/interfaces/discord/requirements.txt"]
        },
        "snyk": {
          "required_tool": "snyk",
          "command": ["snyk", "test", "--file=requirements.txt"]
        }
      }
    },
    "bandit": {
      "module": "command_check",
      "provider_env": "QUALITY_PROVIDER",
      "default_provider": "local",
      "required": false,
      "providers": {
        "local": {
          "required_python_module": "bandit",
          "command": ["python3", "-m", "bandit", "-r", "apps/backend", "-c", "pyproject.toml"]
        },
        "semgrep": {
          "required_tool": "semgrep",
          "command": ["semgrep", "--config", "auto", "apps/backend"]
        },
        "sonar": {
          "required_tool": "sonar-scanner",
          "command": ["sonar-scanner"]
        }
      }
    }
  }
}

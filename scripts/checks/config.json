    "ddd_quality": {
      "module": "ddd_quality",
      "layer_roots": [
        {
          "name": "backend",
          "path": "apps/backend",
          "allow_dirs": ["api", "application", "domain", "infrastructure"],
          "allow_files": ["__init__.py"],
          "ignore_dirs": ["__pycache__"]
        }
      ],
      "root_module_limits": [
        {
          "name": "infrastructure",
          "path": "apps/backend/infrastructure",
          "allow_files": ["__init__.py"],
          "max_files": 0
        }
      ],
      "forbidden_dirs": [],
      "bounded_context_roots": [
        {
          "name": "api",
          "path": "apps/backend/api",
          "allow_files": ["__init__.py", "main.py"]
        },
        {
          "name": "domain",
          "path": "apps/backend/domain",
          "allow_files": ["__init__.py"]
        }
      ],
      "package_roots": [
        {
          "name": "api",
          "path": "apps/backend/api",
          "allow_files": ["__init__.py"],
          "required_dirs": ["controllers"],
          "ignore_dirs": ["__pycache__"]
        }
      ],
      "required_context_files": [
        {
          "name": "application",
          "path": "apps/backend/application",
          "contexts": [
            "agent_runtime",
            "benchmarks",
            "collections",
            "dashboards",
            "identity",
            "model_routing",
            "platform",
            "providers",
            "rag",
            "setup",
            "sharing",
            "studio",
            "tools",
            "voice",
            "workspace"
          ],
          "required": [
            "__init__.py",
            "ports.py",
            "commands/__init__.py",
            "queries/__init__.py",
            "dtos/__init__.py",
            "use_cases/__init__.py"
          ]
        },
        {
          "name": "domain",
          "path": "apps/backend/domain",
          "contexts": [
            "agent_runtime",
            "collections",
            "dashboards",
            "delegation",
            "identity",
            "model_routing",
            "plugin_system",
            "providers",
            "rag",
            "scheduling",
            "setup",
            "shares",
            "studio",
            "tools",
            "voice",
            "workspace"
          ],
          "required": [
            "__init__.py",
            "entities.py",
            "repositories.py",
            "schemas.py",
            "value_objects.py"
          ]
        }
      ],
      "tactical_module_roots": [
        "apps/backend/domain"
      ],
      "forbidden_terms": [
        {
          "name": "backend",
          "path": "apps/backend",
          "terms": ["facade"],
          "ignore_dirs": ["__pycache__", "db/migrations"]
        }
      ],
      "forbidden_module_globs": [
        {
          "name": "infrastructure",
          "path": "apps/backend/infrastructure",
          "patterns": ["*_api.py", "*_websocket.py"],
          "ignore_dirs": ["__pycache__"]
        }
      ],
      "large_file_roots": [
        "apps/backend/api",
        "apps/backend/infrastructure",
        "apps/backend/domain",
        "apps/backend/application"
      ],
      "large_file_enforce": true,
      "large_file_warn_lines": 600,
      "large_file_summary_limit": 12
    },
    "agent_governance": {
      "module": "agent_governance",
      "agents_root": "plugins/agents",
      "required_fields": ["id", "name", "description", "min_role", "requires_workspace", "execution_context"],
      "prompt_warn_max_chars": 8000,
      "prompt_hard_max_chars": 12000,
      "max_pinned_tools": 12,
      "max_tool_allowlist": 80,
      "max_prompt_emoji": 0,
      "forbidden_prompt_phrases": [
        "Your tools (only these)"
      ]
    },
    "backend_unit": {
      "module": "command_check",
      "command": [
        "python3",
        "-m",
        "pytest",
        "tests/unit",
        "tests/benchmarks",
        "-m",
        "not e2e and not benchmark",
        "-q",
        "--tb=short"
      ],
      "env": {
        "PYTHONPATH": "."
      }
    },

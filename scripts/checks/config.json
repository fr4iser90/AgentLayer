    "ddd_layers": {
      "module": "ddd_layers",
      "scope": "staged",
      "include": ["apps/backend"],
      "ignore": [
        "apps/backend/infrastructure/db/migrations/**"
      ],
      "rules": [
        {
          "name": "domain",
          "path": "apps/backend/domain",
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.application",
            "apps.backend.dashboard",
            "apps.backend.infrastructure",
            "apps.backend.infrastructure.integrations",
            "apps.backend.infrastructure.media"
          ]
        },
        {
          "name": "application",
          "path": "apps/backend/application",
          "enforce": false,
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.dashboard",
            "apps.backend.infrastructure.integrations"
          ]
        },
        {
          "name": "api",
          "path": "apps/backend/api",
          "forbidden_imports": [
            "apps.backend.dashboard",
            "apps.backend.infrastructure",
            "apps.backend.infrastructure.integrations"
          ]
        },
        {
          "name": "api_provider_controllers",
          "path": "apps/backend/api/providers/controllers",
          "forbidden_imports": [
            "apps.backend.infrastructure"
          ]
        },
        {
          "name": "infrastructure",
          "path": "apps/backend/infrastructure",
          "forbidden_imports": [
            "apps.backend.api",
            "apps.backend.dashboard"
          ]
        }
      ]
    },

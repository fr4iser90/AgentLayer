{
  "kind": "custom",
  "title": "Inbox overview (example)",
  "description": "Optional aggregator: section for pinned dashboard_ref blocks + friend share widgets. Duplicate via import_layout.",
  "ui_layout": {
    "version": 2,
    "blocks": [
      {
        "id": "inbox-hero",
        "type": "hero",
        "grid": { "x": 0, "y": 0, "w": 12, "h": 4 },
        "props": { "dataPath": "hero", "title": "Overview" }
      },
      {
        "id": "inbox-section",
        "type": "section",
        "grid": { "x": 0, "y": 4, "w": 12, "h": 14 },
        "props": {
          "title": "Pinned & shared",
          "collapsed": false,
          "nested": {
            "version": 2,
            "blocks": [
              {
                "id": "inbox-share-sample",
                "type": "share_widget",
                "grid": { "x": 0, "y": 0, "w": 6, "h": 5 },
                "props": {
                  "title": "Friend calendar",
                  "resourceType": "google_calendar",
                  "friendUserId": "",
                  "friendDisplayName": "",
                  "daysAhead": 7
                }
              }
            ]
          }
        }
      }
    ]
  },
  "initial_data": {
    "hero": {
      "headline": "Inbox",
      "caption": "Pin blocks from other dashboards or add share_widget entries."
    }
  }
}

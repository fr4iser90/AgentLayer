{
  "name": "agent-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "i18n:check": "node scripts/validate-i18n.mjs",
    "i18n:scan": "node scripts/scan-i18n-ui.mjs",
    "lint:type-scale": "node scripts/check-type-scale.mjs",
    "lint:field-surface": "node scripts/check-field-surface.mjs",
    "lint:surface-ladder": "node scripts/check-surface-ladder.mjs",
    "test": "node scripts/test-frontend-i18n.mjs",
    "test:chat-perf": "node --experimental-strip-types scripts/test-chat-perf-metrics.mts",
    "test:chat-agent-selection": "node --experimental-strip-types scripts/test-chat-agent-selection.mts",
    "test:i18n": "npm run test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "e2e:i18n": "node scripts/e2e-playwright-i18n.mjs",
    "probe:overflow": "node scripts/probe-overflow.mjs",
    "build": "npm run test && npm run test:unit && npm run lint:type-scale && npm run lint:field-surface && npm run lint:surface-ladder && npm run lint:ink-color && npm run lint:border-token && npm run lint:font-license && vite build",
    "preview": "vite preview",
    "lint:ink-color": "node scripts/check-ink-color.mjs",
    "lint:ink-color:update": "node scripts/check-ink-color.mjs --update",
    "lint:border-token": "node scripts/check-border-token.mjs",
    "lint:border-token:update": "node scripts/check-border-token.mjs --update",
    "lint:font-license": "node scripts/check-font-license.mjs",
    "lint:font-license:update": "node scripts/check-font-license.mjs --update"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "hls.js": "^1.6.16",
    "i18next": "^26.0.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.3",
    "react-i18next": "^17.0.4",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.27",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "vite": "^8.1.0",
    "vitest": "^5.0.1"
  }
}

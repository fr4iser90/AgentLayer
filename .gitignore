# Auto tool backups (AGENT_TOOLS_BACKUP_DIR=/data/tools/.tool_backups on host)
plugins/tools/agent_created/.tool_backups/
# Generated local Playwright bundles (export_local_playwright_bundle)
plugins/tools/capabilities/browser/output/
# Cache
__pycache__/
output/

# Dashboard UX-audit artifacts: regenerated per run against a live instance and
# carrying that instance's dashboard ids, seed-account email and tenant names.
# They used to be tracked, which meant every audit run produced unmergeable binary
# diffs and published live instance data into the repo. Now written to
# output/ux-audit/; this rule keeps a stale example/ tree from creeping back.
example/dashboard-ux-audit/

# secrets
.qwen/
.env
.env.e2e
benchmarks/results/

# Local-only paths (never publish to public remotes)
docs/planning/knowledge-companion/verticals/_private/
content/_private/
plugins/dashboards/_private/**
!plugins/dashboards/_private/README.md

# logs
logs/

# First-party Agent UI (Vite): deps + production build output
apps/frontend/node_modules/
apps/frontend/dist/

# TUI client: local virtualenv (the package itself is installed with pip -e)
apps/tui/.venv/
apps/tui/*.egg-info/

# Traefik
compose.traefik.yaml

# Runtime project workspaces (AGENTLAYER_WORKSPACE_PATH bind mount target on the
# host). Materialized per-user trees like agentlayer-self/ and e2e-agentlayer-git/
# — runtime data, never source. Anchored to the repo root on purpose: an
# unanchored `workspace/` also swallows apps/backend/infrastructure/workspace/,
# which is real source.
/workspace/

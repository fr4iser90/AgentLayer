# E2E test overlay — copy to .env.e2e (gitignored) and edit.
# Do NOT put these variables in .env (runtime/server config).
#
# Load order: tests/scripts read .env (server) then .env.e2e (test-only keys).
# Keys already set in the shell or .env are not overridden by .env.e2e.
#
# Requires a running Agent Layer instance (Docker compose or local uvicorn).

# --- Primary test user (usually first admin) ---
# Optional: override admin login for pytest. When unset, E2E uses
# AGENT_INITIAL_ADMIN_EMAIL / AGENT_INITIAL_ADMIN_PASSWORD from .env.
# AGENT_E2E_EMAIL=
# AGENT_E2E_PASSWORD=

# --- Secondary user (Journey B social, IDOR matrix) — required for User B tests ---
AGENT_E2E_EMAIL_B=e2e-friend@example.com
AGENT_E2E_PASSWORD_B=e2e-friend-pass-change-me

# --- Server ---
# AGENT_E2E_BASE_URL=http://127.0.0.1:8088
# AGENT_HTTP_PORT=8088

# --- Journey A: git clone workspace (public repo; needs network) ---
# AGENT_E2E_GIT_URL=https://github.com/octocat/Hello-World.git

# --- Journey A optional: semantic index (slow; needs Qdrant/Neo4j) ---
# AGENT_E2E_RUN_INDEX=0

# --- Journey C: WebSocket agent smoke (live LLM on server) ---

# --- Runner (scripts/run-e2e-journeys.sh) ---
# AGENT_E2E_SEED_USERS=1
# AGENT_E2E_MARKERS=e2e

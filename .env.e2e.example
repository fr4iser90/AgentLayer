# Copy to .env.e2e (optional overlay; loaded after .env by E2E scripts/tests).
# Requires a running Agent Layer instance (Docker compose or local uvicorn).

# --- Primary test user (usually first admin) ---
# AGENT_E2E_EMAIL=
# AGENT_E2E_PASSWORD=
# Falls back to AGENT_INITIAL_ADMIN_EMAIL / AGENT_INITIAL_ADMIN_PASSWORD when unset.

# --- Secondary user for Journey B (social) ---
AGENT_E2E_EMAIL_B=e2e-friend@example.com
AGENT_E2E_PASSWORD_B=e2e-friend-pass-change-me

# --- Server ---
# AGENT_E2E_BASE_URL=http://127.0.0.1:8088
# AGENT_HTTP_PORT=8088

# --- Journey A: git clone workspace (public repo; needs network) ---
# AGENT_E2E_GIT_URL=https://github.com/octocat/Hello-World.git

# --- Journey A optional: semantic index (slow; needs Qdrant/Neo4j) ---
# AGENT_E2E_RUN_INDEX=0

# --- Journey C: WebSocket agent smoke (set on server AND test env) ---
# AGENT_E2E_MOCK_LLM=1

# --- Runner ---
# AGENT_E2E_SEED_USERS=1
# AGENT_E2E_INCLUDE_NIGHTLY=0
